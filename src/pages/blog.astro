---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Blog & Actualités | Conseils Ménage, Jardin & Accompagnement à Domagné" description="Conseils pratiques d'entretien de la maison, de jardinage et d'accompagnement à Domagné. Articles à venir prochainement." chemin="blog.html">


    <main class="container main-page">
        
        <!-- En-tête de la page -->
        <section class="service-hero accent-mixed">
            <div class="service-hero-inner">
                <div>
                    <h2>Blog & Actualités</h2>
                    <p>Conseils pratiques, astuces d'entretien et guides pour votre quotidien.</p>
                </div>
                <div class="service-hero-icon">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#B15DC7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
            </div>
        </section>

        <!-- Grille des catégories à venir -->
        <div class="categories-grid">
            
            <!-- Catégorie Ménage -->
            <div class="category-card">
                <span class="status-badge">Prochainement</span>
                <h3>✨ Entretien & Maison</h3>
                <p>Retrouvez nos futurs articles dédiés aux astuces de nettoyage, à l'organisation de votre intérieur et aux conseils pour un espace de vie sain.</p>
                <a href="services-menage.html" class="btn bleu btn-petit">Découvrir nos services</a>
            </div>

            <!-- Catégorie Jardinage -->
            <div class="category-card">
                <span class="status-badge">Prochainement</span>
                <h3>🌳 Jardin & Espaces Verts</h3>
                <p>Nos conseils de jardinier pour réussir vos plantations, entretenir votre pelouse au fil des saisons et valoriser vos espaces extérieurs.</p>
                <a href="espaces-verts.html" class="btn vert btn-petit">Découvrir nos services</a>
            </div>

            <!-- Catégorie Accompagnement -->
            <div class="category-card">
                <span class="status-badge">Prochainement</span>
                <h3>🤝 Accompagnement & Quotidien</h3>
                <p>Nos conseils pour bien accompagner un proche âgé au quotidien et simplifier les démarches administratives courantes.</p>
                <a href="accompagnement.html" class="btn orange btn-petit">Découvrir nos services</a>
            </div>

        </div>

        <!-- Bloc de conversion bas de page -->
        <div class="cta-block">
            <h3>Un projet ou besoin d'une intervention ?</h3>
            <p>N'attendez pas la publication de nos articles. Nos équipes sont disponibles pour répondre à vos demandes dès maintenant.</p>
            <div class="cta-actions">
                <a href="contact.html" class="cta-btn filled-blue">✉️ Nous contacter directement</a>
            </div>
        </div>

    </main>

    
</Layout>
