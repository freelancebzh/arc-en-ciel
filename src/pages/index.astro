---
import Layout from '../layouts/Layout.astro';
const donneesStructurees = {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Arc-en-Ciel Services",
      "image": "https://www.arc-en-ciel-services.fr/photos/general/logo.png",
      "url": "https://www.arc-en-ciel-services.fr/",
      "email": "freelancebzh@gmail.com",
      "priceRange": "€€",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Domagné",
        "postalCode": "35113",
        "addressCountry": "FR"
      },
      "areaServed": {
        "@type": "GeoCircle",
        "geoMidpoint": {
          "@type": "GeoCoordinates",
          "latitude": 48.1167,
          "longitude": -1.4667
        },
        "geoRadius": "20000"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:00",
          "closes": "18:00"
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Services proposés",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Ménage à domicile",
              "url": "https://www.arc-en-ciel-services.fr/services-menage.html"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Entretien d'espaces verts",
              "url": "https://www.arc-en-ciel-services.fr/espaces-verts.html"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Accompagnement à la vie quotidienne",
              "url": "https://www.arc-en-ciel-services.fr/accompagnement.html"
            }
          }
        ]
      }
    };
---
<Layout title="Ménage, Jardin & Accompagnement à Domagné | Arc-en-Ciel Services" description="Arc-en-Ciel Services à Domagné : ménage à domicile, entretien de jardin, accompagnement des personnes âgées. Devis gratuit et crédit d'impôt 50%." titreH1="Services à la Personne à Domagné : ménage, jardin & accompagnement">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(donneesStructurees)} />


    <main>
        <!-- Section Introduction — hero fractionné -->
        <section class="hero-split">
            <div class="container hero-split-inner">
                <div class="hero-copy">
                    <span class="eyebrow">Domagné & environs</span>
                    <h2>Le quotidien, plus léger.</h2>
                    <p>Ménage, jardin, accompagnement — un seul interlocuteur pour prendre soin de votre maison et de vos proches, avec 50% de crédit d'impôt immédiat.</p>
                    <a href="contact.html" class="cta-btn filled-orange">Demander un devis gratuit</a>
                </div>
                <div class="hero-art" aria-hidden="true">
                    <svg viewBox="0 0 440 360" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20 320 A 200 200 0 0 1 420 320" fill="none" stroke="#2E86DE" stroke-width="26" stroke-linecap="round"/>
                        <path d="M62 320 A 158 158 0 0 1 378 320" fill="none" stroke="#3CA35A" stroke-width="26" stroke-linecap="round"/>
                        <path d="M104 320 A 116 116 0 0 1 336 320" fill="none" stroke="#F2B705" stroke-width="26" stroke-linecap="round"/>
                        <path d="M146 320 A 74 74 0 0 1 294 320" fill="none" stroke="#E0703A" stroke-width="26" stroke-linecap="round"/>
                        <path d="M188 320 A 32 32 0 0 1 252 320" fill="none" stroke="#B15DC7" stroke-width="26" stroke-linecap="round"/>
                        <circle cx="80" cy="70" r="9" fill="#F2B705"/>
                        <circle cx="370" cy="110" r="6" fill="#3CA35A"/>
                        <circle cx="340" cy="50" r="5" fill="#B15DC7"/>
                    </svg>
                </div>
            </div>
        </section>

        <!-- Section Aiguillage / Les 3 pôles -->
        <section class="services-grid-offset">
            <div class="container">

                <a href="services-menage.html" class="service-tile t-blue">
                    <div class="tile-icon">
                        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#2E86DE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M9 21V9a3 3 0 0 1 3-3v0a3 3 0 0 1 3 3v12"/><path d="M9 9 5 5"/><path d="m19 5-4 4"/></svg>
                    </div>
                    <h3>Ménage</h3>
                    <p>Entretien de la maison, nettoyage régulier ou ponctuel pour votre confort.</p>
                    <span class="tile-link">Découvrir les prestations →</span>
                </a>

                <a href="espaces-verts.html" class="service-tile t-green">
                    <div class="tile-icon">
                        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#3CA35A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 4 13H2a10 10 0 0 0 10 10z"/><path d="M11 20a7 7 0 0 0 7-7h2a10 10 0 0 1-10 10z"/><path d="M11 20V4a4 4 0 0 1 4-4"/><path d="M11 13a4 4 0 0 0-4-4"/></svg>
                    </div>
                    <h3>Espaces Verts</h3>
                    <p>Tonte, taille, entretien de jardins et aménagements extérieurs pour les particuliers.</p>
                    <span class="tile-link">Découvrir les prestations →</span>
                </a>

                <a href="accompagnement.html" class="service-tile t-orange">
                    <div class="tile-icon">
                        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#E0703A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <h3>Accompagnement</h3>
                    <p>Courses, rendez-vous, sorties et aide administrative pour vos proches, en toute confiance.</p>
                    <span class="tile-link">Découvrir les prestations →</span>
                </a>

            </div>
        </section>

        <!-- Bloc SEO / Présentation locale -->
        <section class="seo-block">
            <div class="container etroit">
                <h2>Arc-en-Ciel Services, votre artisan de confiance à Domagné</h2>
                <p>
                    Basée à Domagné, Arc-en-Ciel Services accompagne les particuliers des environs sur trois savoir-faire : l'<a href="services-menage.html" class="lien-bleu lien-semi">entretien de la maison</a>, l'<a href="espaces-verts.html" class="lien-vert lien-semi">entretien des espaces verts</a> et l'<a href="accompagnement.html" class="lien-orange lien-semi">accompagnement au quotidien</a>.
                </p>
                <p>
                    Que vous cherchiez un service de ménage régulier ou un jardinier pour l'entretien de votre extérieur, Arc-en-Ciel Services intervient directement à Domagné et dans les communes voisines.
                </p>
                <p>
                    Notre approche reste la même quel que soit le service : un interlocuteur unique, un travail soigné, et des solutions pensées pour les besoins réels de chaque foyer. Pas de sous-traitance, pas de discours commercial — juste un artisan qui connaît son territoire.
                </p>
                <p class="seo-cta">
                    📍 Domagné et alentours &nbsp;·&nbsp; ✉️ <a href="contact.html" class="lien-neutre lien-souligne">Contactez-nous</a> pour un devis gratuit et sans engagement.
                </p>
            </div>
        </section>
    </main>

    
</Layout>
