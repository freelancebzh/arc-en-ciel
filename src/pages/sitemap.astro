---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Plan du Site | Arc-en-Ciel Services à la personne Domagné" description="Retrouvez toutes les pages du site Arc-en-Ciel Services à la personne : ménage, jardinage, accompagnement, contact et mentions légales." chemin="sitemap.html">


    <main class="container main-page">

        <section class="service-hero accent-mixed">
            <div class="service-hero-inner">
                <div>
                    <h2>Plan du Site</h2>
                    <p>Retrouvez ici l'ensemble des pages du site Arc-en-Ciel Services.</p>
                </div>
                <div class="service-hero-icon">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#B15DC7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
            </div>
        </section>

        <div class="sitemap-grid">

            <div class="sitemap-block blue">
                <h3>🏠 Général</h3>
                <ul>
                    <li><a href="index.html">Accueil</a></li>
                    <li><a href="contact.html">Contact & Devis</a></li>
                    <li><a href="blog.html">Blog & Actualités</a></li>
                </ul>
            </div>

            <div class="sitemap-block green">
                <h3>🌳 Espaces Verts</h3>
                <ul>
                    <li><a href="espaces-verts.html">Entretien de Jardin à Domagné</a></li>
                </ul>
            </div>

            <div class="sitemap-block blue">
                <h3>✨ Ménage</h3>
                <ul>
                    <li><a href="services-menage.html">Ménage à Domicile à Domagné</a></li>
                </ul>
            </div>

            <div class="sitemap-block orange">
                <h3>🤝 Accompagnement</h3>
                <ul>
                    <li><a href="accompagnement.html">Accompagnement & Aide à Domicile</a></li>
                </ul>
            </div>

         

            <div class="sitemap-block legal">
                <h3>📄 Informations Légales</h3>
                <ul>
                    <li><a href="mentions-legales.html">Mentions Légales</a></li>
                </ul>
            </div>

        </div>

    </main>

    
</Layout>
